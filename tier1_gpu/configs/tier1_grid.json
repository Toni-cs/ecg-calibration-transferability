    "external_corpora": ["PTBXL","CODETEST","CPSC"],
    "seeds": [7,8,9],
    "seed_range": [910000, 910107],
    "optional_pretrain": {"corpus": "CODE2FULL", "arch": "MambaPyRepo", "objective": "JEPA_or_WCR", "in_primary_endpoint": false}
  },

  "stage_c": {
    "gpu": false,
    "estimators": ["SOURCE","GLOBAL","GST","GS_GST","CERT_GATE","HB","M1","M2","M3"],
    "theory": ["Proposition1","Proposition2","T1","T2","T3","T4","mixed_drift_identifiability"],
    "assertions": 360,
    "seed_range": [920000, 920011]
  },

  "compute_assumptions": {
    "note": "PLACEHOLDER. Replace with measured throughput on your GPU before using any budget number.",
