    "PTB-XL / CSN / CPSC overlap the original 60-cell pilot -> external/pressure-test only, not counted in main total"
  ],

  "lead_alignment": {
    "canonical": ["I","II","III","aVR","aVL","aVF","V1","V2","V3","V4","V5","V6"],
    "rule": "ALIGN_BY_NAME_NOT_CHANNEL_INDEX",
    "known_issues": [
      "MIMIC-IV-ECG: aVF/aVL swapped relative to other corpora",
      "CODE-II: DIII/AVR/AVL/AVF reconstructed from 8 essential leads by standard equations",
      "CODE-test limb-lead order differs from CODE-15%"
